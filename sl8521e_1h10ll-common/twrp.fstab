/system	ext4	/dev/block/platform/soc/by-name/system
/system_image	emmc	/dev/block/platform/soc/by-name/system
/vendor	ext4	/dev/block/platform/soc/by-name/vendor
/vendor_image	emmc	/dev/block/platform/soc/by-name/vendor
/productinfo	ext4	/dev/block/platform/soc/by-name/prodnv	flags=display="ProductNV";backup=1
/prodnv_image	emmc	/dev/block/platform/soc/by-name/prodnv	flags=display="ProductNV Image";flashimg=1;backup=1
/data	ext4	/dev/block/platform/soc/by-name/userdata	flags=encryptable=footer
/cache	ext4	/dev/block/platform/soc/by-name/cache
/misc	emmc	/dev/block/platform/soc/by-name/misc
/boot	emmc	/dev/block/platform/soc/by-name/boot
/recovery	emmc	/dev/block/platform/soc/by-name/recovery

/ltemodem	emmc	/dev/block/platform/soc/by-name/l_modem
/ltedsp	emmc	/dev/block/platform/soc/by-name/l_ldsp
/ltegdsp	emmc	/dev/block/platform/soc/by-name/l_gdsp
/ltefixnv1	emmc	/dev/block/platform/soc/by-name/l_fixnv1
/ltefixnv2	emmc	/dev/block/platform/soc/by-name/l_fixnv2
/lteruntimenv1	emmc	/dev/block/platform/soc/by-name/l_runtimenv1
/lteruntimenv2	emmc	/dev/block/platform/soc/by-name/l_runtimenv2
/pmsys	emmc	/dev/block/platform/soc/by-name/pm_sys
/wcnmodem	emmc	/dev/block/platform/soc/by-name/wcnmodem
/gnssmodem	emmc	/dev/block/platform/soc/by-name/gpsgl
/gnssbdmodem	emmc	/dev/block/platform/soc/by-name/gpsbd
/logo	emmc	/dev/block/platform/soc/by-name/logo
/fbootlogo	emmc	/dev/block/platform/soc/by-name/fbootlogo
/persist	emmc	/dev/block/platform/soc/by-name/persist
/uboot	emmc	/dev/block/platform/soc/by-name/uboot
/uboot_bak	emmc	/dev/block/platform/soc/by-name/uboot_bak
/sml	emmc	/dev/block/platform/soc/by-name/sml
/sml_bak	emmc	/dev/block/platform/soc/by-name/sml_bak
/tos	emmc	/dev/block/platform/soc/by-name/trustos
/tos_bak	emmc	/dev/block/platform/soc/by-name/trustos_bak
/spl	emmc	/dev/block/mmcblk0boot0
/spl_bk	emmc	/dev/block/mmcblk0boot1

/external_sd	auto	/dev/block/platform/soc/mmcblk1p1	/dev/block/platform/soc/mmcblk1p1
